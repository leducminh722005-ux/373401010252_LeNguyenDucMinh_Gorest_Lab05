        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Tạo User thành công (Status 201)\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n    var jsonData = pm.response.json();\r\n\r\n    pm.test(\"User có ID hợp lệ\", function () {\r\n        pm.expect(jsonData.id).to.exist;\r\n    });\r\n\r\n    pm.test(\"Tên User chính xác\", function () {\r\n        pm.expect(jsonData.name).to.eql(\"Le Nguyen Duc Minh\");\r\n    });\r\n\r\n    pm.environment.set(\"UserID\", jsonData.id);\r\n    pm.environment.set(\"createdEmail\", jsonData.email);\r\n}\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "\r\n{\r\n    \"name\": \"Le Nguyen Duc Minh\",\r\n    \"gender\": \"male\",\r\n    \"email\": \"minh.lab05.{{$guid}}@example.com\",\r\n    \"status\": \"active\"\r\n}\r\n",
