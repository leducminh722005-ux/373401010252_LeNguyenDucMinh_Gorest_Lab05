{
  "info": {
    "_postman_id": "d109bb8c-f6e8-4914-a372-030959cda0dd",
    "name": "2373401010252_LeNguyenDucMinh_Gorest",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "59100167",
